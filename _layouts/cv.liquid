---
layout: default
---
{% assign cv_email = site.data.socials.email %}
<div class="post cv-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
    <p class="page-links">
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
        >
          Download PDF
        </a>
      {% endif %}
      <a href="mailto:{{ cv_email | encode_email }}">Email</a>
    </p>
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title | slugify }}"></a>
        <section class="cv-card">
          <h2 class="card-title">{{ entry.title }}</h2>

          {% if entry.type == 'list' %}
            <ul>
              {% for content in entry.contents %}
                <li>{{ content }}</li>
              {% endfor %}
            </ul>

          {% elsif entry.type == 'map' %}
            <dl class="cv-map">
              {% for content in entry.contents %}
                <div class="cv-row">
                  <dt>{{ content.name }}</dt>
                  <dd>{{ content.value }}</dd>
                </div>
              {% endfor %}
            </dl>

          {% elsif entry.type == 'nested_list' %}
            <div class="cv-skills">
              {% for content in entry.contents %}
                <p><strong>{{ content.title }}.</strong> {{ content.items | join: ', ' }}</p>
              {% endfor %}
            </div>

          {% elsif entry.type == 'time_table' %}
            {% for content in entry.contents %}
              <div class="cv-row">
                <span class="cv-row__year">{{ content.year }}</span>
                <div class="cv-row__body">
                  {% if content.title %}<h3>{{ content.title }}</h3>{% endif %}
                  {% if content.institution or content.department %}
                    <p class="cv-row__org">
                      {% if content.institution %}{{ content.institution }}{% endif %}
                      {% if content.department %}{% if content.institution %} · {% endif %}{{ content.department }}{% endif %}
                    </p>
                  {% endif %}
                  {% if content.maindescription %}
                    <p class="cv-plain">{{ content.maindescription }}</p>
                  {% endif %}
                  {% if content.description %}
                    <ul>
                      {% for item in content.description %}<li>{{ item }}</li>{% endfor %}
                    </ul>
                  {% endif %}
                  {% if content.items %}
                    <ul>
                      {% for item in content.items %}<li>{{ item }}</li>{% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>
            {% endfor %}

          {% else %}
            {{ entry.contents }}
          {% endif %}
        </section>
      {% endfor %}
    </div>
  </article>
</div>
