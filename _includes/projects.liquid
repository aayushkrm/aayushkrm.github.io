{% if project.redirect %}
  {% assign project_href = project.redirect %}
{% else %}
  {% assign project_href = project.url | relative_url %}
{% endif %}
<li class="project">
  {% if project.img %}
    <a class="project__thumb" href="{{ project_href }}" aria-hidden="true" tabindex="-1">
      {%
        include figure.liquid
        loading="lazy"
        path=project.img
        sizes="120px"
        alt=project.title
      %}
    </a>
  {% endif %}
  <div class="project__body">
    <div class="project__head">
      <h3 class="entry__title"><a href="{{ project_href }}">{{ project.title }}</a></h3>
      {% if project.tags %}
        <span class="entry__date">{{ project.tags | join: ', ' }}</span>
      {% endif %}
    </div>
    <p class="entry__desc">{{ project.description }}</p>
    <p class="entry__meta">
      {% if project.github %}<a href="{{ project.github }}" target="_blank" rel="noopener">Code</a>{% endif %}
      {% if project.demo %}<a href="{{ project.demo }}" target="_blank" rel="noopener">Demo</a>{% endif %}
      <a href="{{ project_href }}">Details</a>
    </p>
  </div>
</li>
