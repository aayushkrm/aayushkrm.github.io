{% assign footer_email = site.data.socials.email %}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <span>&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</span>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <a href="mailto:{{ footer_email | encode_email }}">Email</a>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener">GitHub</a>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener">LinkedIn</a>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <a href="https://twitter.com/{{ site.data.socials.x_username }}" target="_blank" rel="noopener">X</a>
    <span class="site-footer__sep" aria-hidden="true">·</span>
    <a href="{{ '/cv/' | relative_url }}">CV</a>
    {% if site.last_updated %}
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>Last updated {{ 'now' | date: '%B %Y' }}</span>
    {% endif %}
  </div>
</footer>
