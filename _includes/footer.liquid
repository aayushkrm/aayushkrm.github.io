{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}.{% if site.last_updated %} Last updated: {{ 'now' | date: '%B %d, %Y' }}.{% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer
    class="sticky-bottom mt-5"
    role="contentinfo"
    style="background: transparent; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 1.5rem;"
  >
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container text-center" style="color: rgba(255,255,255,0.7);">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
