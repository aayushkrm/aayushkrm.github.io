{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}.{% if site.last_updated %} Last updated: {{ 'now' | date: '%B %d, %Y' }}.{% endif %}
{% endcapture %}

<footer
  role="contentinfo"
  style="background: transparent; border: none; border-top: 1px solid rgba(128, 128, 128, 0.2); padding: 1rem 0; margin-top: 2rem; margin-bottom: 1rem; font-size: 0.875rem; position: static; width: 100%;"
>
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}

  <div style="text-align: center; background: transparent; color: var(--global-text-color); opacity: 0.7;">
    {{ footer_contents }}
  </div>
</footer>
